@page "/expense-tracker/view"

<style>
    .mud-table-container {
        width: 100% !important;
    }

    .mud-table-root {
        table-layout: fixed !important;
        width: 100% !important;
    }
</style>

<MudContainer Class="pa-4 pb-2">
    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.TableView"
                 Size="Size.Large"
                 Color="Color.Primary"/>
        <MudText Typo="Typo.h6"
                 Color="Color.Primary"
                 GutterBottom="false">
            Expense Tracker - View
        </MudText>
    </MudStack>
    <MudText Typo="Typo.caption"
             Style="font-style: italic; opacity: 0.85; letter-spacing: 0.3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;">
        Review & manage your income/expense records
    </MudText>
</MudContainer>

<MudDataGrid @ref="grid"
             T="ExpenseTracker"
             Items="@expenses"
             Breakpoint="Breakpoint.None"
             ColumnResizeMode="ResizeMode.Column"
             Dense="true"
             Hover="true"
             Bordered="true"
             Striped="true"
             HorizontalScrollbar="true"
             Filterable="true"
             FilterMode="DataGridFilterMode.ColumnFilterMenu"
             FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
             QuickFilter="QuickFilterFunc"
             Elevation="0"
             RowsPerPage="10"
             Style="overflow-x: auto;">
    <ToolBarContent>
        <MudTextField Value="searchText"
                      ValueChanged="@(async (string v) =>
                                    {
                                        searchText = v;
                                        await OnSearchTextChanged();
                                    })"
                      Label="Search by category, type, place or detail"
                      ShrinkLabel="true"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentColor="Color.Secondary"
                      Variant="Variant.Text"
                      Margin="Margin.Dense"
                      Immediate="false"
                      Clearable="true"
                      DebounceInterval="300"/>
            <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                           Color="Color.Secondary"
                           OnClick="@ToggleFilterPopover"/>

        <MudPopover Open="@_showFilterPopover"
                    AnchorOrigin="Origin.BottomRight"
                    TransformOrigin="Origin.TopRight"
                    Class="pa-4 mt-2"
                    Style="width: 280px; max-width: 90vw; z-index: 1500;"
                    Elevation="4">
            <MudStack Spacing="3">
                <MudText Typo="Typo.subtitle2"
                         Color="Color.Primary">Filter Records
                </MudText>

                <MudSelect T="string"
                           Label="Categories"
                           MultiSelection="true"
                           SelectAll="true"
                           SelectAllText="Select All"
                           SelectedValues="_selectedCategories"
                           SelectedValuesChanged="OnCategoriesChanged"
                           Dense="true"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var category in _dbCategories)
                    {
                        <MudSelectItem T="string"
                                       Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string"
                           Label="Types"
                           MultiSelection="true"
                           SelectAll="true"
                           SelectAllText="Select All"
                           SelectedValues="_selectedTypes"
                           SelectedValuesChanged="OnTypesChanged"
                           Dense="true"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var type in _dbTypes)
                    {
                        <MudSelectItem T="string"
                                       Value="@type">@type</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string"
                           Label="Places"
                           MultiSelection="true"
                           SelectAll="true"
                           SelectAllText="Select All"
                           SelectedValues="_selectedPlaces"
                           SelectedValuesChanged="OnPlacesChanged"
                           Dense="true"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var place in _dbPlaces)
                    {
                        <MudSelectItem T="string"
                                       Value="@place">@place</MudSelectItem>
                    }
                </MudSelect>

                <MudDateRangePicker Label="Date Range"
                                    DateRange="_selectedDateRange"
                                    DateRangeChanged="OnDateRangeChanged"
                                    PickerVariant="PickerVariant.Dialog"
                                    ShowToolbar="false"
                                    Clearable="true"
                                    Dense="true"
                                    Margin="Margin.Dense"/>
                <MudNumericField T="decimal?" 
                                 Value="_price"
                                 ValueChanged="OnPriceFilterChanged"
                                 Label="Amount" 
                                 DebounceInterval="300"
                                 IconSize="Size.Small" 
                                 Required="true" 
                                 Margin="Margin.Dense"
                                 InputMode="@(InputMode.@decimal)" 
                                 Format="N0" 
                                 Culture="@CultureInfo.InvariantCulture" 
                                 Min="0" 
                                 Max="999999" 
                                 Placeholder="0"
                                 Clearable="true" 
                                 HideSpinButtons="true" />

                <div class="d-flex justify-between align-center mt-2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="ClearAllFilters"
                               Disabled="@(ActiveFilterCount == 0 && string.IsNullOrEmpty(searchText))">
                        Reset
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => _showFilterPopover = false)">
                        Close
                    </MudButton>
                </div>
            </MudStack>
        </MudPopover>

    </ToolBarContent>
    <Columns>
        <TemplateColumn Title="Expense Details">
            <CellTemplate>
                <MudStack Spacing="0"
                          Class="py-2">
                    <MudStack Row="true"
                              Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.caption"
                                 Color="Color.Primary">
                            <b>@context.Item.Date.ToString("ddd, MMM dd, yyyy")</b>
                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Style="opacity:0.8">
                            @context.Item.Category • @context.Item.Type
                        </MudText>
                    </MudStack>

                    <MudText Typo="Typo.body2"
                             Class="mt-1">
                        <b>@context.Item.Place</b>
                        @if (!string.IsNullOrEmpty(context.Item.Detail))
                        {
                            <span style="opacity:0.7;"> — @context.Item.Detail</span>
                        }
                    </MudText>

                    @if (!string.IsNullOrEmpty(context.Item.TripDestination) || context.Item.AutoPayDate.HasValue)
                    {
                        <MudStack Row="true"
                                  Spacing="2"
                                  Class="mt-1">
                            @if (!string.IsNullOrEmpty(context.Item.TripDestination))
                            {
                                <MudChip T="string"
                                         Icon="@Icons.Material.Filled.Commute"
                                         Size="Size.Small"
                                         Variant="Variant.Text"
                                         Color="Color.Info"
                                         Class="ma-0 px-0">
                                    @context.Item.TripDestination
                                </MudChip>
                            }

                            @if (context.Item.AutoPayDate.HasValue)
                            {
                                <MudChip T="string"
                                         Icon="@Icons.Material.Filled.Autorenew"
                                         Size="Size.Small"
                                         Variant="Variant.Text"
                                         Color="Color.Primary"
                                         Class="ma-0 px-0">
                                    @Constants.AutoPay.Frequencies.GetValueOrDefault(context.Item.Frequency ?? "", context.Item.Frequency ?? "—")
                                </MudChip>
                            }
                        </MudStack>
                    }

                    <MudStack Row="true"
                              Justify="Justify.SpaceBetween"
                              AlignItems="AlignItems.Center"
                              Class="mt-2">
                        <MudText Typo="Typo.body1"
                                 Color="@(context.Item.Category == "Income" ? Color.Secondary : Color.Success)">
                            <b>@context.Item.Price.ToString("C", new System.Globalization.CultureInfo(culture))</b>
                        </MudText>

                        <div class="d-flex align-center">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => OpenEditDialogAsync(context.Item))"/>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => Delete(context.Item))"/>
                        </div>
                    </MudStack>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <PagerContent>
        <MudStack Row
                  Justify="Justify.Center"
                  AlignItems="AlignItems.Center"
                  Spacing="3"
                  Class="pa-4 my-2">
            <!-- First Page -->
            <MudIconButton OnClick="@(async () =>
                                    {
                                        if (grid != null)
                                        {
                                            grid.NavigateTo(Page.First);
                                            await InvokeAsync(StateHasChanged);
                                        }
                                    })"
                           Icon="@Icons.Material.Filled.FirstPage"
                           Color="Color.Tertiary"
                           Variant="Variant.Filled"
                           Size="Size.Small"
                           Disabled="@(grid?.CurrentPage <= 0)"/>

            <!-- Previous -->
            <MudIconButton OnClick="@(async () =>
                                    {
                                        if (grid != null)
                                        {
                                            grid.NavigateTo(Page.Previous);
                                            await InvokeAsync(StateHasChanged);
                                        }
                                    })"
                           Icon="@Icons.Material.Filled.ChevronLeft"
                           Color="Color.Tertiary"
                           Variant="Variant.Filled"
                           Size="Size.Small"
                           Disabled="@(grid?.CurrentPage <= 0)"/>

            <!-- Rows per page selector -->
            <MudSelect T="int"
                       Value="@(grid?.RowsPerPage ?? 10)"
                       ValueChanged="OnPageSizeChanged"
                       Label="Show records"
                       ShrinkLabel="true"
                       Variant="Variant.Text"
                       Dense="true"
                       Margin="Margin.Dense"
                       Style="width: 70px; margin-right: 16px; margin-left: 8px;">
                <MudSelectItem Value="10">10</MudSelectItem>
                <MudSelectItem Value="25">25</MudSelectItem>
                <MudSelectItem Value="50">50</MudSelectItem>
                <MudSelectItem Value="100">100</MudSelectItem>
            </MudSelect>

            <!-- Next -->
            <MudIconButton OnClick="@(async () =>
                                    {
                                        if (grid != null)
                                        {
                                            grid.NavigateTo(Page.Next);
                                            await InvokeAsync(StateHasChanged);
                                        }
                                    })"
                           Icon="@Icons.Material.Filled.ChevronRight"
                           Color="Color.Tertiary"
                           Variant="Variant.Filled"
                           Size="Size.Small"
                           Disabled="@(grid == null || expenses == null || (grid.CurrentPage + 1) * grid.RowsPerPage >= grid.FilteredItems.Count())"/>

            <!-- Last Page -->
            <MudIconButton OnClick="@(async () =>
                                    {
                                        if (grid != null)
                                        {
                                            grid.NavigateTo(Page.Last);
                                            await InvokeAsync(StateHasChanged);
                                        }
                                    })"
                           Icon="@Icons.Material.Filled.LastPage"
                           Color="Color.Tertiary"
                           Variant="Variant.Filled"
                           Size="Size.Small"
                           Disabled="@(grid == null || expenses == null || (grid.CurrentPage + 1) * grid.RowsPerPage >= grid.FilteredItems.Count())"/>
        </MudStack>
    </PagerContent>

    <NoRecordsContent>
        <MudContainer>
            <MudText Align="Align.Left">No entries yet!</MudText>
        </MudContainer>
    </NoRecordsContent>
</MudDataGrid>

@if (!string.IsNullOrEmpty(errorMsg))
{
    <MudAlert Severity="Severity.Success" Class="mt-4">@errorMsg</MudAlert>
}

@code {

    bool categorySetting = false;
    private string errorMsg = "", searchText = "", culture = "";
    private IEnumerable<ExpenseTracker>? expenses;
    private MudDataGrid<ExpenseTracker>? grid;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            List<Setting> Settings = await SettingsService.GetSettingsAsync();
            string country = Settings.Where(x => x.SettingKey == "country").FirstOrDefault()?.SettingValue!;
            culture = SettingsService.GetCultureCode(country);
            var CategorySetting = Settings.Where(x => x.SettingKey == "category");
            if (!string.IsNullOrEmpty(CategorySetting.FirstOrDefault()!.SettingValue))
                categorySetting = true;
            _dbCategories = await ExpenseTrackerService.GetCategoriesAsync(string.Empty, !categorySetting);
            await LoadExpenses();
        }
        catch (Exception ex)
        {
            LoggerService.Log($"OnInitializedAsync - {this.GetType().FullName}", ex);
            Snackbar.Add(Constants.OnLoadErrorMessage, Severity.Error);
        }
    }

    private async Task LoadExpenses()
    {
        expenses = await ExpenseTrackerService.GetAllExpensesAsync();
    }

    private async Task OnPageSizeChanged(int newSize)
    {
        if (grid != null)
        {
            await grid.SetRowsPerPageAsync(newSize);
            grid.NavigateTo(Page.First);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenEditDialogAsync(ExpenseTracker expense)
    {
        var parameters = new DialogParameters<Edit> { { x => x.Expense, expense }, { x => x.OnSaved, RefreshGrid } };

        var options = new DialogOptions()
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            BackdropClick = false
        };

        await DialogService.ShowAsync<Edit>("Edit Expense", parameters, options);
    }

    private async Task RefreshGrid()
    {
        await LoadExpenses();
        StateHasChanged();
    }

    private async Task Delete(ExpenseTracker obj)
    {
        bool? result = await DialogService.ShowMessageBoxAsync("Confirm Delete", "Are you sure you want to delete this expense? This action cannot be undone.", yesText: "Yes", cancelText: "Cancel");

        try
        {
            if (result == true) // User clicked "Yes"
            {
                int n = await ExpenseTrackerService.DeleteExpenseAsync(obj.Id);

                if (n > 0)
                    Snackbar.Add("Entry deleted successfully!", Severity.Success);

                await RefreshGrid();
            }
        }
        catch (Exception ex)
        {
            await DialogService.ShowMessageBoxAsync("Error", ex.Message, "OK");
        }
    }

    //Filter Logic
    private bool _showFilterPopover = false;
    private decimal? _price;
    private List<string> _dbCategories = new();
    private List<string> _dbTypes = new();
    private List<string> _dbPlaces = new();
    private IReadOnlyCollection<string> _selectedCategories = new HashSet<string>();
    private IReadOnlyCollection<string>? _selectedTypes = new HashSet<string>();
    private IReadOnlyCollection<string>? _selectedPlaces = new HashSet<string>();
    private DateRange _selectedDateRange = new DateRange(null, null);

    private int ActiveFilterCount =>
        (_selectedCategories != null && _selectedCategories.Any() ? 1 : 0) +
        (_selectedTypes != null && _selectedTypes.Any() ? 1 : 0) +
        (_selectedPlaces != null && _selectedPlaces.Any() ? 1 : 0) +
        (_price != null  ? 1 : 0) +
        (_selectedDateRange?.Start != null ? 1 : 0);

    private void ToggleFilterPopover()
    {
        _showFilterPopover = !_showFilterPopover;
    }

    private bool QuickFilterFunc(ExpenseTracker e)
    {
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var term = searchText.Trim().ToLowerInvariant();
            bool matchesText = (e.Category?.ToLowerInvariant().Contains(term) ?? false) ||
                               (e.Type?.ToLowerInvariant().Contains(term) ?? false) ||
                               (e.Place?.ToLowerInvariant().Contains(term) ?? false) ||
                               (e.Detail?.ToLowerInvariant().Contains(term) ?? false);

            bool matchesPrice = e.Price.ToString().Contains(term);
            
            if (!matchesText && !matchesPrice) return false;
        }

        if (_selectedCategories != null && _selectedCategories.Any())
            if (!_selectedCategories.Contains(e.Category))
                return false;

        if (_selectedTypes != null && _selectedTypes.Any())
            if (!_selectedTypes.Contains(e.Type))
                return false;

        if (_selectedPlaces != null && _selectedPlaces.Any())
            if (!_selectedPlaces.Contains(e.Place))
                return false;

        if (_selectedDateRange?.Start != null && _selectedDateRange?.End != null)
        {
            var startDate = DateOnly.FromDateTime(_selectedDateRange.Start.Value);
            var endDate = DateOnly.FromDateTime(_selectedDateRange.End.Value);

            if (e.Date < startDate || e.Date > endDate)
                return false; // The expense falls outside your chosen DateOnly window
        }
        
        if (_price.HasValue)
        {
            string filterTerm = _price.Value.ToString();
            string actualPrice = e.Price.ToString();

            if (!actualPrice.Contains(filterTerm))
                return false;
        }
        
        return true;
    }

    private async Task OnCategoriesChanged(IReadOnlyCollection<string> values)
    {
        _selectedCategories = values ?? new HashSet<string>();
        _dbTypes = await ExpenseTrackerService.GetTypesAsync(_selectedCategories);
        _selectedTypes = _selectedTypes?
            .Where(type => _dbTypes.Contains(type))
            .ToHashSet() ?? new HashSet<string>();
        _dbPlaces = await ExpenseTrackerService.GetPlacesAsync(_selectedCategories, _selectedTypes);
        _selectedPlaces = _selectedPlaces?
            .Where(place => _dbPlaces.Contains(place))
            .ToHashSet() ?? new HashSet<string>();

        if (grid != null) await grid.ReloadServerData();
    }

    private async Task OnTypesChanged(IReadOnlyCollection<string> values)
    {
        _selectedTypes = values ?? new HashSet<string>();
        _dbPlaces = await ExpenseTrackerService.GetPlacesAsync(_selectedCategories, _selectedTypes);
        _selectedPlaces = _selectedPlaces?
            .Where(place => _dbPlaces.Contains(place))
            .ToHashSet() ?? new HashSet<string>();

        if (grid != null) await grid.ReloadServerData();
    }

    private async Task OnPlacesChanged(IReadOnlyCollection<string> values)
    {
        _selectedPlaces = values ?? new HashSet<string>();
        if (grid != null) await grid.ReloadServerData();
    }

    private async Task OnDateRangeChanged(DateRange range)
    {
        _selectedDateRange = range;
        if (grid != null) await grid.ReloadServerData();
    }
    
    private async Task OnPriceFilterChanged(decimal? newValue)
    {
        _price = newValue;
        if (grid != null) 
            await grid.ReloadServerData(); 
    }
    
    private async Task OnSearchTextChanged()
    {
        if (grid != null) await grid.ReloadServerData();
    }

    private async Task ClearAllFilters()
    {
        _selectedCategories = new HashSet<string>();
        _selectedTypes = new HashSet<string>();
        _selectedPlaces = new HashSet<string>();
        _selectedDateRange = new DateRange(null, null);
        _dbCategories = new List<string>();
        _dbTypes = new List<string>();
        _dbPlaces = new List<string>();
        _price = null;
        searchText = "";
        _showFilterPopover = false;

        if (grid != null) await grid.ReloadServerData();
    }

}