@if (isVisible)
{
    @foreach (var summary in summaries)
    {
        <MudCard Elevation="4"
                 Class="mb-6 rounded-xl overflow-hidden"
                 Style="border-top: 6px solid var(--mud-palette-primary); box-shadow: 0 10px 15px -3px rgba(var(--mud-palette-primary-rgb), 0.2);">
            <MudGrid Spacing="0">
                <MudItem xs="12"
                         sm="5">
                    <div style="position: relative; height: 100%; min-height: 160px;"
                         class="d-flex align-center justify-center">
                        @if (summary.IsLoading)
                        {
                            <MudProgressLinear Indeterminate="true"
                                               Color="Color.Primary"
                                               Class="mx-6"
                                               Style="width: 70%;"/>
                        }
                        else if (!string.IsNullOrEmpty(summary.ImageUrl))
                        {
                            <MudImage Src="@summary.ImageUrl"
                                      Alt="Vehicle"
                                      Fluid="true"
                                      ObjectFit="ObjectFit.Cover"
                                      Style="width: 100%; height: 100%; min-height: 160px;"/>
                        }
                        else
                        {
                            <MudIcon Icon="@(summary.IsEv ? Icons.Material.Filled.ElectricCar : Icons.Material.Filled.DirectionsCar)"
                                     Size="Size.Large"
                                     Style="opacity: 0.3;"/>
                        }

                        <div style="position: absolute; bottom: 8px; right: 8px; display: flex; gap: 8px;">
                            @if (!string.IsNullOrEmpty(summary.ImageUrl))
                            {
                                <MudIconButton OnClick="@(() => ClearVehicleImage(summary))"
                                               Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Style="background: var(--mud-palette-surface);"/>
                            }
                            <MudIconButton OnClick="@(() => PasteImageFromClipboard(summary))"
                                           Icon="@Icons.Material.Filled.ContentPaste"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           Disabled="@summary.IsLoading"
                                           Style="background: var(--mud-palette-surface);"/>
                            <MudIconButton OnClick="@(() => TriggerImageUpload(summary))"
                                           Icon="@Icons.Material.Filled.PhotoCamera"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           Style="background: var(--mud-palette-surface);"/>
                        </div>
                    </div>
                </MudItem>

                <MudItem xs="12"
                         sm="7"
                         Class="pa-4">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h6"><b>@summary.Vehicle</b></MudText>

                        <MudDivider Class="my-1"/>

                        <MudSimpleTable Dense="true"
                                        Hover="false"
                                        Elevation="0"
                                        Style="background: transparent;">
                            <tbody>
                            <tr>
                                <td>
                                    <MudText Typo="Typo.caption">Distance</MudText>
                                </td>
                                <td class="text-end"><b>@summary.TotalMileage @distanceLabel</b></td>
                            </tr>
                            <tr>
                                <td>
                                    <MudText Typo="Typo.caption">Cost</MudText>
                                </td>
                                <td class="text-end">
                                    <b>@summary.TotalFuelCost.ToString("C", new CultureInfo(culture))</b></td>
                            </tr>
                            <tr>
                                <td>
                                    <MudText Typo="Typo.caption">@filledLabel</MudText>
                                </td>
                                <td class="text-end"><b>@summary.TotalFuelFilled @volumeUnit</b></td>
                            </tr>
                            <tr>
                                <td>
                                    <MudText Typo="Typo.caption">@mileageLabel</MudText>
                                </td>
                                <td class="text-end"><b>@summary.FuelMileage @economyUnit</b></td>
                            </tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudCard>
    }
}

@code {

    bool isImperial, hasEv, hasGas, isVisible;
    string culture = "", distanceLabel = "", filledLabel = "", mileageLabel = "", volumeUnit = "", economyUnit = "";
    private readonly List<VehicleSummary> summaries = new();
    private int _imageLoadVersion;
    Breakpoint breakpoint = Breakpoint.None;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settingsTask = SettingsService.GetSettingsAsync();
            var summariesTask = MileageTrackerService.GetDashboardSummariesAsync();
            await Task.WhenAll(settingsTask, summariesTask);

            var Settings = await settingsTask;
            var country = Settings.Where(x => x.SettingKey == "country").FirstOrDefault()?.SettingValue!;
            culture = SettingsService.GetCultureCode(country);
            isImperial = Settings.Any(x => x.SettingKey == "country" && x.SettingValue.ToLower() == "united states");

            await LoadVehicleSummaries(await summariesTask);
        }
        catch (Exception ex)
        {
            LoggerService.Log($"OnInitializedAsync - {GetType().FullName}", ex);
            Snackbar.Add(Constants.OnLoadErrorMessage, Severity.Error);
        }
    }

    private async Task LoadVehicleSummaries(List<VehicleMileageSummary> rows)
    {
        summaries.Clear(); // Clear to prevent duplicates on refresh

        foreach (var row in rows)
        {
            summaries.Add(new VehicleSummary
            {
                Vehicle = row.Vehicle,
                ImageUrl = "",
                TotalMileage = row.TotalMileage.ToString("N0"),
                TotalFuelCost = row.TotalFuelCost,
                TotalFuelFilled = row.TotalFuelFilled.ToString(),
                FuelMileage = row.FuelMileage.ToString(),
                IsEv = StateService.GetVehicleIsEV(row.Vehicle)
            });
        }

        breakpoint = summaries.Count > 1 ? Breakpoint.SmAndDown : Breakpoint.Sm;

        hasEv = summaries.Any(x => x.IsEv);
        hasGas = summaries.Any(x => !x.IsEv);

        if (hasEv && !hasGas)
        {
            filledLabel = "Energy";
            mileageLabel = "Efficiency";
            volumeUnit = "(kWh)";
            economyUnit = isImperial ? "(mi/kWh)" : "(kWh/100km)";
        }
        else if (hasGas && !hasEv)
        {
            filledLabel = "Fuel Filled";
            mileageLabel = "Fuel Economy";
            volumeUnit = isImperial ? "(Gallons)" : "(Litres)";
            economyUnit = isImperial ? "(MPG)" : "(L/100km)";
        }
        else
        {
            filledLabel = "Volume";
            mileageLabel = "Economy";
            foreach (var summary in summaries)
            {
                summary.TotalFuelFilled += summary.IsEv ? "(kWh)" : isImperial ? "(G)" : "(L)";
                summary.FuelMileage += summary.IsEv ? isImperial ? "(mi/kWh)" : "(kWh/100km)" : isImperial ? "(MPG)" : "(L/100km)";
            }
        }

        distanceLabel = isImperial ? "(miles)" : "(km)";
        isVisible = summaries.Count > 0;
        ShowCachedImagesAndLoadTheRest();
    }

    // Cached photos appear with the totals. A cache miss reads the database off the UI thread.
    private void ShowCachedImagesAndLoadTheRest()
    {
        var version = ++_imageLoadVersion;
        var pending = new List<VehicleSummary>();
        foreach (var summary in summaries)
        {
            if (SettingsService.TryGetCachedVehicleImage(summary.Vehicle, out var cached))
            {
                summary.ImageUrl = cached;
                summary.IsLoading = false;
            }
            else
            {
                summary.ImageUrl = "";
                summary.IsLoading = true;
                pending.Add(summary);
            }
        }

        if (pending.Count == 0)
            return;

        _ = Task.Run(() => LoadImagesAsync(pending, version));
    }

    private async Task LoadImagesAsync(List<VehicleSummary> pending, int version)
    {
        foreach (var summary in pending)
        {
            if (version != _imageLoadVersion)
                return;

            var url = "";
            try
            {
                url = await SettingsService.GetVehicleImageAsync(summary.Vehicle);
            }
            catch (Exception ex)
            {
                LoggerService.Log($"LoadImagesAsync - {GetType().FullName}", ex);
            }

            if (version != _imageLoadVersion)
                return;

            try
            {
                await InvokeAsync(() =>
                {
                    if (version != _imageLoadVersion)
                        return;
                    summary.ImageUrl = url;
                    summary.IsLoading = false;
                    StateHasChanged();
                });
            }
            catch (ObjectDisposedException)
            {
                return;
            }
        }
    }

    private const long MaxImageBytes = 10 * 1024 * 1024;
    
    private async Task TriggerImageUpload(VehicleSummary item)
    {
        try
        {
            var fileTypes = new FilePickerFileType(
                new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.iOS, new[] { "public.image" } },
                    { DevicePlatform.Android, new[] { "image/*" } },
                    { DevicePlatform.WinUI, new[] { ".jpg", ".png", ".gif" } }
                });

            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Select Vehicle Photo",
                FileTypes = fileTypes
            });
            if (result == null) return;

            using var stream = await result.OpenReadAsync();
            await ProcessAndSaveImageAsync(item, stream);
        }
        catch (Exception ex)
        {
            LoggerService.Log($"TriggerImageUpload - {GetType().FullName}", ex);
            Snackbar.Add("The image could not be selected.", Severity.Error);
        }
    }

    private async Task PasteImageFromClipboard(VehicleSummary item)
    {
        try
        {
            if (!await ClipboardImage.HasImageAsync())
            {
                await ShowAlertAsync("No Image Copied", "Copy an image first, then tap paste.");
                return;
            }

            var message = string.IsNullOrEmpty(item.ImageUrl)
                ? $"Use the copied image for {item.Vehicle}?"
                : $"Replace the current image for {item.Vehicle} with the copied image?";

            if (!await ConfirmAsync("Paste Image", message)) return;

            using var stream = await ClipboardImage.OpenImageStreamAsync();
            if (stream == null)
            {
                await ShowAlertAsync("Paste Failed", "The copied image could not be read.");
                return;
            }

            await ProcessAndSaveImageAsync(item, stream);
        }
        catch (Exception ex)
        {
            LoggerService.Log($"PasteImageFromClipboard - {GetType().FullName}", ex);
            Snackbar.Add("The copied image could not be pasted.", Severity.Error);
        }
    }

    private async Task ClearVehicleImage(VehicleSummary item)
    {
        if (!await ConfirmAsync("Remove Image", "This will remove the image from the database. Are you sure?"))
            return;

        item.ImageUrl = "";
        await SettingsService.UpdateVehicleImagePathAsync(item.Vehicle, "");
        Snackbar.Add("Image removed.", Severity.Info);
        StateHasChanged();
    }

    // ---------- Shared pipeline (upload + paste) ----------

    private async Task ProcessAndSaveImageAsync(VehicleSummary item, Stream source)
    {
        var original = await ReadWithLimitAsync(source, MaxImageBytes);
        if (original == null)
        {
            await ShowAlertAsync("File Too Large", "Please select an image under 10MB.");
            return;
        }

        item.IsLoading = true;
        StateHasChanged();

        try
        {
            // Decode, resize, encode and DB write all happen off the UI thread
            var dataUrl = await Task.Run(async () =>
            {
                var url = SettingsService.ToJpegDataUrl(original);
                await SettingsService.UpdateVehicleImagePathAsync(item.Vehicle, url);
                return url;
            });

            item.ImageUrl = dataUrl;
        }
        catch (Exception ex)
        {
            LoggerService.Log($"ProcessAndSaveImageAsync - {GetType().FullName}", ex);
            Snackbar.Add("The image could not be processed.", Severity.Error);
        }
        finally
        {
            item.IsLoading = false;
            StateHasChanged();
        }
    }

    // Returns null if the stream exceeds maxBytes. Works for non-seekable streams too.
    private static async Task<byte[]?> ReadWithLimitAsync(Stream source, long maxBytes)
    {
        using var ms = new MemoryStream();
        var buffer = new byte[81920];
        int read;
        while ((read = await source.ReadAsync(buffer)) > 0)
        {
            if (ms.Length + read > maxBytes) return null;
            ms.Write(buffer, 0, read);
        }
        return ms.ToArray();
    }

    // ---------- Dialog helpers ----------

    // Fully qualified because MudBlazor also has a type named Page
    private static Microsoft.Maui.Controls.Page? CurrentPage =>
        Application.Current?.Windows?.FirstOrDefault()?.Page;

    private async Task ShowAlertAsync(string title, string message)
    {
        var page = CurrentPage;
        if (page != null)
            await page.DisplayAlertAsync(title, message, "OK");
        else
            Snackbar.Add(message, Severity.Warning);
    }

    private async Task<bool> ConfirmAsync(string title, string message)
    {
        var page = CurrentPage;
        if (page == null)
        {
            Snackbar.Add("Unable to show confirmation dialog.", Severity.Warning);
            return false;
        }
        return await page.DisplayAlertAsync(title, message, "Yes", "No");
    }
    public class VehicleSummary
    {
        public string Vehicle { get; set; } = "";
        public string? ImageUrl { get; set; }
        public string TotalMileage { get; set; } = "";
        public decimal TotalFuelCost { get; set; }
        public string TotalFuelFilled { get; set; } = "";
        public string FuelMileage { get; set; } = "";
        public bool IsEv { get; set; }
        public bool IsLoading { get; set; }
    }

}
