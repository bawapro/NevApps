<style>
    .mud-table-container {
        width: 100% !important;
    }

    .mud-table-root {
        table-layout: fixed !important;
        width: 100% !important;
    }
</style>

@if (isVisible)
{
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mb-2">
        <MudText Typo="Typo.subtitle1" Style="font-style: italic; opacity: 0.85;" Class="mt-1">
            @(showAll ? $"Annual Spending ({DateTime.Today.Year})" : $"Your Expenses for {DateTime.Now:MMMM}")
        </MudText>

        <MudIconButton OnClick="async () => { showAll = !showAll; await LoadSummaryData(); }" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       Icon="@(showAll ? Icons.Material.Rounded.ArrowCircleLeft : Icons.Material.Rounded.ArrowCircleRight)" />
    </MudStack>

    <MudDataGrid @bind-SelectedItem="_selectedItem" T="ExpenseSummaryItem" Items="@summaryItems" RowClick="@RowClicked" Elevation="0"
                 Hover="true" Dense="true" Groupable="true" Filterable="false">
        <Columns>
            <TemplateColumn T="ExpenseSummaryItem" Title="@(isVisible ? (showAll ? "Monthly Breakdown" : "Category") : "")">
                <CellTemplate>
                    <MudStack Spacing="0" Class="py-2">
                        @* Top Line: Category and Amount *@
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body1" Style="font-weight: 500;">
                                @(showAll? context.Item.Month : context.Item.Category)
                            </MudText>

                            <MudText Typo="Typo.body1" Color="Color.Success" Style="font-weight: 700;">
                                @context.Item.TotalAmount.ToString("C", new System.Globalization.CultureInfo(culture))
                            </MudText>
                        </MudStack>

                        @* Bottom Line: Tap Indicator *@
                        <MudStack Row AlignItems="AlignItems.Center" Style="opacity: 0.5;">
                            <MudText Typo="Typo.caption" Class="mr-1">Tap for details</MudText>
                            <MudIcon Icon="@(_selectedItem == context.Item ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                                     Size="Size.Small" />
                        </MudStack>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            @if (_selectedItem == context.Item)
            {
                <MudCard Elevation="0"
                         Class="py-3 pr-3 pl-1 mb-2"
                         Style="background-color: var(--mud-palette-background-grey);
                    border-left: 6px solid var(--mud-palette-primary);
                    border-radius: 0 8px 8px 0;
                    margin-left: 0;
                    width: 80%;">

                    <MudStack Row AlignItems="AlignItems.Center" Class="mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
                        <MudText Typo="Typo.overline" Color="Color.Primary" Style="line-height: 1;"><b>Type</b></MudText>
                    </MudStack>

                    @foreach (var detail in context.Item.Details)
                    {
                        <MudStack Row Justify="Justify.SpaceBetween" Class="py-1 pl-1">
                            <MudText Typo="Typo.caption">@detail.Name</MudText>
                            <MudText Typo="Typo.caption" Style="font-weight: 600;">
                                @detail.Amount.ToString("C", new CultureInfo(culture))
                            </MudText>
                        </MudStack>
                    }
                </MudCard>
            }
        </ChildRowContent>

        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                <MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" Size="Size.Large" Style="opacity:0.2;" />
                <MudText Typo="Typo.body2" Align="Align.Center" Style="opacity: 0.6;">
                    @noRecordsLabel
                </MudText>
            </MudStack>
        </NoRecordsContent>
    </MudDataGrid>
}

@code {

    private bool showAll = false, isVisible = false;
    private string culture = "", noRecordsLabel = "";
    private List<ExpenseTracker> allExpenses = new();
    private List<ExpenseSummaryItem> summaryItems = new();
    private ExpenseSummaryItem? _selectedItem;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            List<Setting> Settings = await SettingsService.GetSettingsAsync();
            string country = Settings.Where(x => x.SettingKey == "country").FirstOrDefault()?.SettingValue!;
            culture = SettingsService.GetCultureCode(country);
            await LoadSummaryData();
            noRecordsLabel = allExpenses.Count > 0 && summaryItems.Count == 0 ? "No Records for current Month. Start entering your expenses." : "";
        }
        catch (Exception ex)
        {
            LoggerService.Log($"OnInitializedAsync - {this.GetType().FullName}", ex);
            Snackbar.Add(Constants.OnLoadErrorMessage, Severity.Error);
        }
    }

    private void RowClicked(DataGridRowClickEventArgs<ExpenseSummaryItem> args)
    {
        if (_selectedItem == args.Item)
        {
            _selectedItem = null;
        }
        else
        {
            _selectedItem = args.Item;
        }

        StateHasChanged();
    }
    private async Task LoadSummaryData()
    {
        allExpenses = await ExpenseTrackerService.GetAllExpensesAsync();
        var today = DateTime.Today;
        var cultureObj = new CultureInfo(culture);

        if (!showAll)
        {
            summaryItems = allExpenses
                .Where(x => x.Date.Month == today.Month && x.Date.Year == today.Year && x.Category != "Income")
                .GroupBy(x => x.Category)
                .Select(g => new ExpenseSummaryItem
                {
                    Category = g.Key,
                    TotalAmount = g.Sum(e => e.Price),
                    Details = g.GroupBy(sub => sub.Type)
                               .Select(d => new CategoryBreakup
                               {
                                   Name = d.Key ?? "Uncategorized",
                                   Amount = d.Sum(s => s.Price)
                               }).ToList()
                })
                .OrderByDescending(x => x.TotalAmount)
                .ToList();
        }
        else
        {
            summaryItems = allExpenses
                .Where(x => x.Date.Year == today.Year && x.Category != "Income")
                .GroupBy(x => x.Date.Month)
                .Select(g => new ExpenseSummaryItem
                {
                    // Use the user's culture for the month name
                    Month = cultureObj.DateTimeFormat.GetMonthName(g.Key),
                    TotalAmount = g.Sum(e => e.Price),
                    Details = g.GroupBy(c => c.Category)
                               .Select(sub => new CategoryBreakup
                               {
                                   Name = sub.Key,
                                   Amount = sub.Sum(s => s.Price)
                               }).ToList()
                })
                .OrderBy(x => DateTime.ParseExact(x.Month, "MMMM", cultureObj).Month)
                .ToList();
        }
        isVisible = summaryItems.Any() || allExpenses.Any();
        StateHasChanged();
    }

    private void ToggleRow(ExpenseSummaryItem item)
    {
        if (_selectedItem == item)
            _selectedItem = null;
        else
            _selectedItem = item;
    }

    public class ExpenseSummaryItem
    {
        public string Month { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal TotalAmount { get; set; }
        public List<CategoryBreakup> Details { get; set; } = new();
        public bool ShowDetails { get; set; }
    }

    public class CategoryBreakup
    {
        public string Name { get; set; } = "";// Can be Category OR Type
        public decimal Amount { get; set; }
    }
}
