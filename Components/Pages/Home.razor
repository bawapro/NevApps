@page "/"
@inject ReminderService ReminderService
@using NevApps.Components.Pages.Dashboard
@implements IDisposable

<PullToRefresh OnRefresh="OnPullRefresh">
@if (firstLaunch)
{
    <MudAlert Severity="Severity.Info"
              Variant="Variant.Outlined"
              Icon="@Icons.Material.Filled.RocketLaunch"
              Class="mb-4">
        <strong>Welcome to NevApps</strong>
        <br/>
        Please
        <MudLink Href="/view-settings"
                 Underline="Underline.Always"><b>set up your profile</b></MudLink>
        (Apps, Country, Vehicles, & Categories) to get started.
    </MudAlert>
}
else
{
    if (showDashboard)
    {
        <MudContainer Class="pa-4 pb-2">
            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Dashboard"
                         Size="Size.Large"
                         Color="Color.Primary"/>

                <MudText Typo="Typo.h5"
                         Color="Color.Primary"
                         GutterBottom="false">
                    Dashboard
                </MudText>

                <MudSpacer/>

                @if (showAnnouncement)
                {
                    <MudBadge Dot="showAnnouncement"
                              Color="Color.Error"
                              Overlap="true"
                              Bordered="true"
                              Visible="@(showAnnouncement)">
                        <MudIconButton Icon="@Icons.Material.Filled.Campaign"
                                       Size="Size.Large"
                                       OnClick="@(() => NavigationManager.NavigateTo("/announce"))"/>
                    </MudBadge>
                }
            </MudStack>
        </MudContainer>
    }

    @if (isEmpty)
    {
        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Outlined"
                  Class="mt-4">
            Start adding expenses, mileage, and auto payment details to see your summary here.
        </MudAlert>
    }

    @if (isExpense || isAutoPay || isMileage || isShenshai)
    {
        <MudToggleGroup T="int"
                        @bind-Value="activeTab"
                        @bind-Value:after="TrackDashboardTab"
                        Outlined="true"
                        Delimiters="true"
                        Class="mx-4 mt-2"
                        Size="Size.Small">

            @if (isExpense)
            {
                <MudToggleItem Value="1">
                    @if (UseDashboardIcons)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong"
                                 Title="Expenses"/>
                    }
                    else
                    {
                        <span>Expenses</span>
                    }
                </MudToggleItem>
            }

            @if (isAutoPay)
            {
                <MudToggleItem Value="2">
                    @if (UseDashboardIcons)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Autorenew"
                                 Title="Auto Pay"/>
                    }
                    else
                    {
                        <span>Auto Pay</span>
                    }
                </MudToggleItem>
            }

            @if (isMileage)
            {
                <MudToggleItem Value="3">
                    @if (UseDashboardIcons)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsCar"
                                 Title="Mileage"/>
                    }
                    else
                    {
                        <span>Mileage</span>
                    }
                </MudToggleItem>
            }

            @if (isShenshai)
            {
                <MudToggleItem Value="4">
                    @if (UseDashboardIcons)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Event"
                                 Title="Reminders"/>
                    }
                    else
                    {
                        <span>Reminders</span>
                    }
                </MudToggleItem>
            }
        </MudToggleGroup>
    }

    <div class="pa-4">
        @if (activeTab == 1 && isExpense)
        {
            <ExpenseSummary @key="_paneKey"/>
        }
        else if (activeTab == 2 && isAutoPay)
        {
            <AutoPay @key="_paneKey"/>
        }
        else if (activeTab == 4 && isShenshai)
        {
            <Reminders @key="_paneKey"/>
        }

        @if (_mileageMounted && isMileage)
        {
            <div class="@(activeTab == 3 ? null : "d-none")">
                <MileageSummary @key="_paneKey"/>
            </div>
        }
    </div>
}
</PullToRefresh>

@code {
    private int activeTab = 1;
    private int _paneKey;
    private bool _mileageMounted;
    private bool _ready;
    private bool _reloading;

    private bool firstLaunch,
        isExpense,
        isAutoPay,
        isMileage,
        isShenshai,
        showAnnouncement,
        isEmpty,
        showDashboard;

    private bool UseDashboardIcons =>
        (isExpense ? 1 : 0) + (isAutoPay ? 1 : 0) + (isMileage ? 1 : 0) + (isShenshai ? 1 : 0) >= 4;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadDashboardAsync(true);
        }
        catch (Exception ex)
        {
            LoggerService.Log($"OnInitializedAsync - {GetType().FullName}", ex);
            Snackbar.Add(Constants.OnLoadErrorMessage, Severity.Error);
        }
        finally
        {
            _ready = true;
        }
    }

    private async Task LoadDashboardAsync(bool setDefaultTab)
    {
        var Settings = await SettingsService.GetSettingsAsync();
        firstLaunch = Settings.Count <= 1;
        if (firstLaunch)
            return;

        var autoPayments = await ExpenseTrackerService.GetAutoPayments(true);
        if (autoPayments != null && autoPayments.Count() > 0)
            await UpdateAutoPay(autoPayments);

        showDashboard = await SettingsService.CheckDashboardAsync();
        (isExpense, isAutoPay, isMileage, isShenshai) = await SettingsService.CheckDashboardCountsAsync();
        if (isShenshai)
            isShenshai = await ReminderService.HasUpcomingRemindersAsync();

        if (setDefaultTab || !IsTabAvailable(activeTab))
        {
            if (isExpense)
                activeTab = 1;
            else if (isAutoPay)
                activeTab = 2;
            else if (isMileage)
                activeTab = 3;
            else if (isShenshai)
                activeTab = 4;
            else
                activeTab = 0;
        }
        
        showAnnouncement = await SettingsService.CheckNewAnnouncement();

        isEmpty = !isExpense && !isMileage && !isAutoPay && !isShenshai;
        if (isMileage)
        {
            if (activeTab == 3)
                _mileageMounted = true;
            MileageTrackerService.WarmDashboard();
        }
    }

    private async Task OnPullRefresh()
    {
        if (_reloading)
            return;

        _reloading = true;
        try
        {
            await LoadDashboardAsync(false);
            _paneKey++;
        }
        catch (Exception ex)
        {
            LoggerService.Log($"OnPullRefresh - {GetType().FullName}", ex);
            Snackbar.Add(Constants.OnLoadErrorMessage, Severity.Error);
        }
        finally
        {
            _reloading = false;
        }
    }

    private void TrackDashboardTab()
    {
        if (activeTab == 3)
            _mileageMounted = true;
    }

    private bool IsTabAvailable(int tab)
    {
        return tab switch
        {
            1 => isExpense,
            2 => isAutoPay,
            3 => isMileage,
            4 => isShenshai,
            _ => false
        };
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_ready || !IsDashboardPath())
            return;

        _ = InvokeAsync(TryReloadDashboardAsync);
    }

    private bool IsDashboardPath()
    {
        var path = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (path.Length > 1)
            path = path.TrimEnd('/');
        return string.Equals(path, NavSections.Home, StringComparison.OrdinalIgnoreCase);
    }

    private async Task TryReloadDashboardAsync()
    {
        if (_reloading || !StateService.DashboardReload)
            return;

        StateService.DashboardReload = false;
        _reloading = true;
        try
        {
            await LoadDashboardAsync(false);
            _paneKey++;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            LoggerService.Log($"TryReloadDashboardAsync - {GetType().FullName}", ex);
            Snackbar.Add(Constants.OnLoadErrorMessage, Severity.Error);
        }
        finally
        {
            _reloading = false;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task UpdateAutoPay(List<NevDBClass.Models.ExpenseTracker> autoPayments)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        foreach (var payment in autoPayments!)
        {
            if (payment.AutoPayDate.HasValue && payment.AutoPayDate.Value <= today && !string.IsNullOrEmpty(payment.Frequency))
            {
                try
                {
                    var id = payment.Id;
                    var oldDate = payment.Date;

                    //Insert new entry
                    payment.Id = 0;
                    payment.Date = payment.AutoPayDate.Value;
                    payment.AutoPayDate = ExpenseTrackerService.GetNextDate(payment.AutoPayDate.Value, payment.Frequency);
                    var n = await ExpenseTrackerService.UpdateAutoPaymentsAsync(payment);

                    //Update previous entry
                    payment.Id = id;
                    payment.Date = oldDate;
                    payment.AutoPayDate = null;
                    payment.AutoPay = null;
                    payment.Frequency = null;
                    n = await ExpenseTrackerService.UpdateAutoPaymentsAsync(payment);

                    if (n > 0)
                        Snackbar.Add($"Auto payment for {payment.Detail} updated.", Severity.Info);
                }
                catch (Exception ex)
                {
                    Snackbar.Add(ex.ToString(), Severity.Error);
                }
            }
        }
    }

}