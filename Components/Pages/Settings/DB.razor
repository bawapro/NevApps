@page "/settings/db"

<style>
    /* Force-squeeze the table cells */
    .tight-table td, .tight-table th {
        padding: 4px 8px !important;
        font-size: 0.8rem;
    }
</style>

<MudStack Spacing="1">
    @if (backups!.Count > 0)
    {
        <MudTable Items="backups"
                  Dense="true"
                  Breakpoint="Breakpoint.None"
                  Class="tight-table">
            <HeaderContent>
                <MudTh>Backup</MudTh>
                <MudTh>Details</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>
                    <MudText Typo="Typo.body2"
                             Style="font-weight:500">
                        @context.FileName.Replace(".db3", "")
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2"
                             Class="text-muted">
                        @context.CreatedAt.ToString("MMM dd") • @(context.FileSizeBytes / 1024)KB
                    </MudText>
                </MudTd>
                <MudTd Style="text-align:right; white-space:nowrap">
                    <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="() => Restore(context.FileName)"
                                   Class="pa-1"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="() => Delete(context.FileName)"
                                   Class="pa-1"/>
                </MudTd>
            </RowTemplate>

            <FooterContent>
                <td colspan="3"
                    class="pa-2">
                    <MudStack Row="true"
                              Justify="Justify.SpaceBetween"
                              AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption">@backups?.Count / 5 Backups</MudText>
                        <MudText Typo="Typo.caption"
                                 Color="Color.Info">
                            @($"{backups?.Sum(b => b.FileSizeBytes / 1024.0 / 1024.0):N2} MB")
                        </MudText>
                    </MudStack>
                </td>
            </FooterContent>
        </MudTable>
    }

    @if (!Constants.IsAdmin)
    {
        <MudTextField @bind-Value="backupName"
                      Label="Name your backup"
                      HelperText="Eg. First Backup"
                      MaxLength="15"
                      Counter="15"
                      Immediate="true"
                      Margin="Margin.Dense"
                      Variant="Variant.Text"/>
    }
</MudStack>

<MudStack Row
          Spacing="1"
          AlignItems="AlignItems.Center"
          Justify="Justify.Center">
    <MudButton Size="Size.Small"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Backup"
               IconSize="Size.Small"
               OnClick="CreateBackup">
        <MudText Typo="Typo.caption">Backup</MudText>
    </MudButton>

    @if (Constants.IsAdmin)
    {
        <MudButton Size="Size.Small"
                   Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.RestorePage"
                   IconSize="Size.Small"
                   OnClick="RestoreFromDownloadFolder">
            <MudText Typo="Typo.caption">Restore</MudText>
        </MudButton>
    }

    <MudButton Size="Size.Small"
               Variant="Variant.Filled"
               Color="Color.Error"
               StartIcon="@Icons.Material.Filled.DeleteForever"
               IconSize="Size.Small"
               OnClick="ClearAll">
        <MudText Typo="Typo.caption">Clear</MudText>
    </MudButton>
</MudStack>

@code {

    private string backupName { get; set; } = "";
    private List<BackupRestore>? backups = new();


    [Inject] BackupRestoreService BackupRestoreService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            backups = await BackupRestoreService.GetAllBackupsAsync();

            if (DeviceInfo.Platform == DevicePlatform.Android)
            {
                if (!await RequestStoragePermission())
                {
                    Snackbar.Add("Storage permission denied", Severity.Warning);
                }
            }
        }
        catch (Exception ex)
        {
            LoggerService.Log($"OnInitializedAsync - {GetType().FullName}", ex);
            Snackbar.Add(Constants.OnLoadErrorMessage, Severity.Error);
        }
    }

    private async Task CreateBackup()
    {
        if (Constants.IsAdmin)
        {
            await ExportBackupViaShare();
            return;
        }

        if (string.IsNullOrEmpty(backupName))
        {
            var confirm = await DialogService.ShowMessageBoxAsync("Create Backup", "No name was provided for this backup.\n\nThis will **overwrite** any existing unnamed backup.\n\nContinue?",
                "Yes", cancelText: "No");

            if (confirm != true) return;
        }

        var (success, msg) = await BackupRestoreService.CreateBackupAsync(backupName);
        Snackbar.Add(msg, success ? Severity.Success : Severity.Error);
        backups = await BackupRestoreService.GetAllBackupsAsync();
    }

    private async Task Restore(string fileName)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Restore", "This will overwrite your current database. Continue?", "Yes", cancelText: "No");
        if (confirm != true) return;

        var (success, msg) = await BackupRestoreService.RestoreBackupAsync(fileName, false, null);
        Snackbar.Add(msg, success ? Severity.Success : Severity.Error);
        NavigationManager.NavigateTo("/", true);
    }

    private async Task RestoreFromDownloadFolder()
    {
        try
        {
            // Pick file from Downloads / any shared location
            var pickerResult = await FilePicker.Default.PickAsync();

            if (pickerResult == null)
            {
                Snackbar.Add("No file selected", Severity.Info);
                return;
            }

            var confirm = await DialogService.ShowMessageBoxAsync(
                "Import Database",
                "This will **overwrite** your current database with the selected backup. Continue?",
                "Yes",
                cancelText: "No");

            if (confirm != true) return;

            var currentDb = Path.Combine(FileSystem.AppDataDirectory, Constants.DbName);
            await using var stream = await pickerResult.OpenReadAsync();
            var (success, msg) = await BackupRestoreService.RestoreBackupAsync(currentDb, true, stream);
            Snackbar.Add(msg, success ? Severity.Success : Severity.Error);

            if (success)
                NavigationManager.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            LoggerService.Log("Import DB failed", ex);
            Snackbar.Add("Import failed. Check logs.", Severity.Error);
        }
    }

    private async Task<bool> RequestStoragePermission()
    {
        var status = await Permissions.CheckStatusAsync<Permissions.StorageRead>();

        if (status != PermissionStatus.Granted)
        {
            status = await Permissions.RequestAsync<Permissions.StorageRead>();
        }

        return status == PermissionStatus.Granted;
    }

    private async Task Delete(string fileName)
    {
        var backupDisplayName = Path.GetFileNameWithoutExtension(fileName);
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Delete Backup",
            $"Delete the backup \"{backupDisplayName}\" permanently?",
            "Delete",
            cancelText: "Cancel");
        if (confirm == true)
        {
            BackupRestoreService.DeleteBackup(fileName);
            backups = await BackupRestoreService.GetAllBackupsAsync();
            Snackbar.Add("Backup deleted", Severity.Info);
        }
    }

    private async Task ClearAll()
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Clear All Data", "This will permanently delete all your data. Continue?", "Yes", cancelText: "No");
        if (confirm == true)
        {
            await BackupRestoreService.ClearEverything();
            Snackbar.Add("Data wipe-out complete.", Severity.Warning);
            NavigationManager.NavigateTo("/", true);
        }
    }

    private async Task ExportBackupViaShare()
    {
        try
        {
            var sourceDb = Path.Combine(FileSystem.AppDataDirectory, Constants.DbName);

            if (!File.Exists(sourceDb))
            {
                Snackbar.Add("Database not found", Severity.Error);
                return;
            }

            var tempFile = Path.Combine(FileSystem.CacheDirectory, string.IsNullOrWhiteSpace(backupName) ? $"NEVDB_{DateTime.Now:yyyyMMdd_HHmm}.db3" : $"{backupName}_{DateTime.Now:yyyyMMdd_HHmm}.db3");

            File.Copy(sourceDb, tempFile, true);

            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Export Database Backup",
                File = new ShareFile(tempFile, "application/octet-stream") // or "application/x-sqlite3"
            });
        }
        catch (Exception ex)
        {
            LoggerService.Log("Share export failed", ex);
            Snackbar.Add("Export failed", Severity.Error);
        }
    }

}