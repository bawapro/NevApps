@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Color="Color.Primary" Elevation="1" Dense="@IsNavCompact" Class="@AppBarCssClass">
        <MudImage Src="images/logo-t.png" Height="@(IsNavCompact ? 22 : 25)" Width="@(IsNavCompact ? 22 : 25)" Class="mr-1" />
        <MudText Typo="Typo.h6" Class="app-brand-title">NevApps</MudText>
        <MudSpacer />
        <div class="app-nav-icons">
            @if ((isExpenseTrackerOn || isMileageTrackerOn || isShenshaiOn))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Home"
                               Size="Size.Small"
                               Color="@GetIconColor(AppNav.Home)"
                               OnClick="@(() => NavigateTo(AppNav.Home))" />
            }

            @if (isExpenseTrackerOn)
            {
                <MudIconButton Icon="@currencyIcon"
                               Size="Size.Small"
                               Color="@GetIconColor(AppNav.Expense)"
                               OnClick="@(() => NavigateTo(AppNav.Expense))" />
            }

            @if (isMileageTrackerOn)
            {
                <MudIconButton Icon="@Icons.Material.Rounded.DirectionsCarFilled"
                               Size="Size.Small"
                               Color="@GetIconColor(AppNav.Mileage)"
                               OnClick="@(() => NavigateTo(AppNav.Mileage))" />
            }

            @if (isShenshaiOn)
            {
                <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth"
                               Size="Size.Small"
                               Color="@GetIconColor(AppNav.Shenshai)"
                               OnClick="@(() => NavigateTo(AppNav.Shenshai))" />
            }

            @if (isStepsTrackerOn)
            {
                <MudIconButton Icon="@Icons.Material.Filled.DirectionsWalk"
                               Size="Size.Small"
                               Color="@GetIconColor(AppNav.Steps)"
                               OnClick="@(() => NavigateTo(AppNav.Steps))" />
            }
            <MudIconButton Icon="@Icons.Material.Filled.Settings"
                           Size="Size.Small"
                           Color="@GetIconColor(AppNav.Settings)"
                           OnClick="@(() => NavigateTo(AppNav.Settings))" />
        </div>
    </MudAppBar>
    <MudMainContent Style="padding-bottom: 40px !important;">
        <SwipeNavigator ExpenseEnabled="isExpenseTrackerOn"
                        MileageEnabled="isMileageTrackerOn"
                        ShenshaiEnabled="isShenshaiOn"
                        StepsEnabled="isStepsTrackerOn">
            @Body
        </SwipeNavigator>
    </MudMainContent>
</MudLayout>

@code {
    private bool isExpenseTrackerOn = false, isMileageTrackerOn = false, isShenshaiOn = false, isStepsTrackerOn = false;
    private string? currencyIcon;

    private bool IsNavCompact => VisibleNavIconCount >= 6;
    private string AppBarCssClass => IsNavCompact ? "app-topbar app-topbar-compact" : "app-topbar";

    private int VisibleNavIconCount
    {
        get
        {
            var count = 1; // Settings is always visible
            if (isExpenseTrackerOn || isMileageTrackerOn || isShenshaiOn)
                count++;
            if (isExpenseTrackerOn)
                count++;
            if (isMileageTrackerOn)
                count++;
            if (isShenshaiOn)
                count++;
            if (isStepsTrackerOn)
                count++;
            return count;
        }
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currencyIcon = await SettingsService.GetCurrencyIcon();
            (isExpenseTrackerOn, isMileageTrackerOn, isShenshaiOn, isStepsTrackerOn) = await SettingsService.GetFeaturesAsync();

            if (!isExpenseTrackerOn && !isMileageTrackerOn && isStepsTrackerOn && !isShenshaiOn)
            {
                NavigationManager.NavigateTo(AppNav.Steps);
                return;
            }

            if (!isExpenseTrackerOn && !isMileageTrackerOn && isStepsTrackerOn && isShenshaiOn)
            {
                NavigationManager.NavigateTo(AppNav.Shenshai);
                return;
            }
        }
        catch (Exception ex)
        {
            LoggerService.Log($"OnInitializedAsync - {this.GetType().FullName}", ex);
            Snackbar.Add(Constants.OnLoadErrorMessage, Severity.Error);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private MudBlazor.Color GetIconColor(string path)
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return AppNav.IsActive(relative, path)
            ? MudBlazor.Color.Warning
            : MudBlazor.Color.Inherit;
    }

    private void NavigateTo(string path)
    {
        NavigationManager.NavigateTo(path);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}